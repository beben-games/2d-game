# Godot 4
.godot/
/android/
export_credentials.cfg
*.translation

# Local output
reports/
builds/
*.tmp

# OS and tools
.DS_Store
Thumbs.db
.claude/worktrees/
.claude/settings.local.json

# Third-party assets whose terms forbid reposting them. They ship inside the release builds but are
# never committed; docs/ASSETS.md lists where to get each file. Without them the game draws
# placeholder icons and plays those sounds as silence.
assets/raven_icons/*.png
assets/raven_icons/*.png.import
assets/guns/*.png
assets/guns/*.png.import
assets/music/*.ogg
assets/music/*.ogg.import
assets/music/*.wav
assets/music/*.wav.import
assets/reserve/casper_mz/
assets/reserve/shikashi_v2/
assets/sfx/player_hurt.wav*
assets/sfx/player_die.wav*
assets/sfx/door_open.wav*
assets/sfx/door_seal.wav*
assets/sfx/die_imp.wav*
assets/sfx/die_shaman.wav*
assets/sfx/boss_spawn.wav*
assets/sfx/boss_phase.wav*
assets/sfx/boss_die.wav*
# M7 (2026-10-10), Classic Monster Sounds too: the beast's roar, the handler's call, the charger's wind-up, three deaths
assets/sfx/beast_roar.wav*
assets/sfx/handler_call.wav*
assets/sfx/charge_windup.wav*
assets/sfx/die_beast.wav*
assets/sfx/die_handler.wav*
assets/sfx/die_charger.wav*
assets/music/*.ogg.import
assets/reserve/minifantasy_loops/
assets/reserve/creepy_horn.wav
# M5 packs (2026-09-25): CHAWPNEM, Pixabay crowd and cinematic files, Land of the Ancients, the Coins [OGG] set, the moneywithjj samplers: no redistribution as files
assets/sfx/crowd_*.wav*
assets/sfx/coin_*.wav*
assets/sfx/buy.wav*
assets/sfx/buy_denied.wav*
assets/sfx/gate.wav*
assets/sfx/verdict_*.wav*

# Art pipeline: raw generations (every candidate and reject) stay local; env files never go in
art/raw/
.env
.env.*
art/work/
